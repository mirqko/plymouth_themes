sprite = Sprite(frames[1]);

sprite.SetX(
  Window.GetX() + Window.GetWidth() / 2 - frames[1].GetWidth() / 2
);

sprite.SetY(
  Window.GetY() + Window.GetHeight() / 2 - frames[1].GetHeight() / 2
);

# ~30 FPS:
# 1 / 30 = 0.0333 seconds per frame.
#
# Plymouth's Script plugin calls the refresh function according
# to its refresh timing, so each callback advances exactly one frame.

fun refresh_callback ()
  {
    sprite.SetImage(frames[frame]);

    frame++;

    if (frame > 76)
      {
        frame = 1;
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);